# Pinpoint server environment (copy to server/.env).
# The authoritative variable list is the "Environment variables reference"
# in README.md. Only names the code actually reads are listed here.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pinpoint
DB_USER=postgres
DB_PASSWORD=your_password_here
# Optional, migrations only (production profile of server/knexfile.ts).
# Falls back to DB_* when unset; the API itself never reads it.
# DATABASE_URL=

# Auth
# Exposed deployments require >= 32 bytes: openssl rand -base64 48
JWT_SECRET=generate-a-secure-random-string-here
# Required on exposed deployments (NODE_ENV=production, PINPOINT_SELF_HOST=1,
# or a non-loopback HOST):
# OAUTH_STATE_SECRET=
# INTEGRATION_ENCRYPTION_KEY=   # 32 bytes, base64 or 64-char hex: openssl rand -base64 32

# Social sign-in and integration OAuth apps (all optional; see docs/INTEGRATIONS_SETUP.md).
# Sign-in redirect URI: ${OAUTH_CALLBACK_BASE_URL}/api/v1/auth/oauth/<google|github>/callback
# OAUTH_CALLBACK_BASE_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Integration redirect URI: ${APP_URL}/api/v1/integrations/<provider>/callback
# INTEGRATION_SLACK_CLIENT_ID=
# INTEGRATION_SLACK_CLIENT_SECRET=
# INTEGRATION_JIRA_CLIENT_ID=
# INTEGRATION_JIRA_CLIENT_SECRET=
# INTEGRATION_LINEAR_CLIENT_ID=
# INTEGRATION_LINEAR_CLIENT_SECRET=
# INTEGRATION_GITHUB_CLIENT_ID=
# INTEGRATION_GITHUB_CLIENT_SECRET=
# Optional scope overrides, e.g. INTEGRATION_GITHUB_SCOPES=public_repo
# INTEGRATION_GITHUB_SCOPES=

# Server
PORT=3001
# Dashboard origin. `*` is rejected on exposed deployments.
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
# HOST=localhost
# Bearer token required for GET /metrics (otherwise private-network callers only)
# METRICS_TOKEN=
# Per-IP /api request ceiling per 15 minutes (default 100)
# API_RATE_LIMIT_MAX=100

# Email. Defaults to a local SMTP sink on localhost:1025 (e.g. Mailpit);
# uncomment and set all of these for a real provider.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@pinpoint.local

# Object storage (optional, for screenshots): any S3-compatible service (MinIO,
# Cloudflare R2, Backblaze B2, ...). The access key pair is read by the S3 client
# library from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY; the server reads only
# these names:
# S3_BUCKET=pinpoint
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# Redis (optional – enables multi-instance rate limiting & Socket.IO adapter)
REDIS_URL=redis://localhost:6379

# Dashboard dev server (vite): API origin to proxy to (default http://localhost:3001)
# API_PROXY_TARGET=http://localhost:3001
# Extension build: default API origin baked into the bundle
# VITE_PINPOINT_API_ORIGIN=http://localhost:3001

# Behind a reverse proxy / load balancer, set to the number of proxy hops
# (e.g. 1 for a single Caddy/nginx) so rate limits see the real client IP.
# TRUST_PROXY=1
# Rate-limit ceilings (defaults shown).
# API_RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_IP_MAX=20
# TENANT_RATE_LIMIT_MAX=1000

