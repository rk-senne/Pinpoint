# Pinpoint production environment (deploy/docker-compose.prod.yml).
#
#   cp deploy/.env.production.example deploy/.env.production
#   chmod 600 deploy/.env.production      # never commit the real file
#
# Every value marked REQUIRED must be replaced. The values below are
# placeholders that satisfy `docker compose config`; they are NOT secrets.
# The API refuses to boot (exit 1) if a secret is missing, a placeholder or
# too short (NODE_ENV=production strict preflight).

# --- Public hostname ---------------------------------------------------------
# DNS A/AAAA record must point at this host; ports 80/443 must be open.
# CORS_ORIGIN and APP_URL are derived as https://$DOMAIN by the compose file.
DOMAIN=pinpoint.example.com
# Let's Encrypt contact (expiry notices). REQUIRED.
ACME_EMAIL=admin@pinpoint.example.com

# --- Secrets (REQUIRED) ------------------------------------------------------
# >= 32 bytes:                      openssl rand -base64 48
JWT_SECRET=REPLACE_ME_openssl_rand_base64_48_0000000000000000
# HMAC key for the OAuth state cookie: openssl rand -base64 48
OAUTH_STATE_SECRET=REPLACE_ME_openssl_rand_base64_48_0000000000000000
# AES-256-GCM key, exactly 32 bytes: openssl rand -base64 32
# (placeholder below is a valid-length dummy; generate your own)
INTEGRATION_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Bearer token for GET /metrics, >= 16 chars: openssl rand -base64 24
METRICS_TOKEN=REPLACE_ME_openssl_rand_base64_24
# Postgres password, must not be "postgres": openssl rand -hex 24
DB_PASSWORD=REPLACE_ME_openssl_rand_hex_24
# Password of the unprivileged `pinpoint_app` role the API connects as (RLS, PP-08): openssl rand -hex 24
DB_APP_PASSWORD=REPLACE_ME_openssl_rand_hex_24
DB_USER=pinpoint
DB_NAME=pinpoint

# --- Reverse proxy -----------------------------------------------------------
# One trusted hop (Caddy) so rate limits and logs see the real client IP.
# Never `true`; the preflight rejects it.
TRUST_PROXY=1

# --- Email (REQUIRED for verification / password reset) ----------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true = implicit TLS (usually port 465); false = STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pinpoint.example.com

# --- Screenshot storage ------------------------------------------------------
# Default: local disk on the `screenshots` Docker volume (/data/screenshots) -
# no provider needed. Back the volume up (deploy/backup.sh does).
# STORAGE_DRIVER=local            # local | s3 (unset = s3 only if S3_* creds are set)
#
# Optional: any S3-compatible service (MinIO, Cloudflare R2, Backblaze B2,
# Wasabi, Ceph, ...). Setting S3_ENDPOINT or the access key selects s3.
# S3_BUCKET=pinpoint
# S3_REGION=auto                      # R2: auto; B2: e.g. us-west-004; MinIO: us-east-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true            # MinIO and most self-hosted stores
# S3_PUBLIC_BASE_URL=https://cdn.example.com   # public base URL for stored objects
# S3_KEY_PREFIX=annotations/screenshots
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Optional features -------------------------------------------------------
# DIGEST_ENABLED=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_CALLBACK_BASE_URL=https://pinpoint.example.com   # sign-in redirect base
# Integration OAuth apps (docs/INTEGRATIONS_SETUP.md). Redirect URI:
#   https://$DOMAIN/api/v1/integrations/<provider>/callback
# INTEGRATION_SLACK_CLIENT_ID=
# INTEGRATION_SLACK_CLIENT_SECRET=
# INTEGRATION_JIRA_CLIENT_ID=
# INTEGRATION_JIRA_CLIENT_SECRET=
# INTEGRATION_LINEAR_CLIENT_ID=
# INTEGRATION_LINEAR_CLIENT_SECRET=
# INTEGRATION_GITHUB_CLIENT_ID=
# INTEGRATION_GITHUB_CLIENT_SECRET=
# NOTE: the api service in docker-compose.prod.yml must forward these (see docs).

# --- Images (optional overrides) ---------------------------------------------
# Pin a specific build instead of :latest, e.g. the commit SHA:
# PINPOINT_SERVER_IMAGE=ghcr.io/rk-senne/pinpoint/server:<sha>
# PINPOINT_DASHBOARD_IMAGE=ghcr.io/rk-senne/pinpoint/dashboard:<sha>

# --- Backups -----------------------------------------------------------------
# deploy/backup.sh dumps Postgres and tars the screenshots volume into
# ./backups (retention: BACKUP_RETENTION_DAYS, default 14). Cron example:
#   30 2 * * * /opt/pinpoint/deploy/backup.sh >> /var/log/pinpoint-backup.log 2>&1
# Copy ./backups off the host (rsync/rclone). Restore: docs/DEPLOYMENT.md.

# --- Monitoring & alerting (optional, $0; docs/MONITORING.md) -----------------
# Enable the profile: COMPOSE_PROFILES=monitoring (or `docker compose --profile monitoring`;
# PINPOINT_MONITORING=1 deploy/install.sh sets this and the Grafana password for you).
# COMPOSE_PROFILES=monitoring
# Grafana (bound to 127.0.0.1:3000; reach it through an SSH tunnel). Default: METRICS_TOKEN.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=                 # openssl rand -hex 16
# Alerts are e-mailed through the SMTP_* relay above.
# ALERT_EMAIL_TO=                         # default: ACME_EMAIL
# ALERT_NOTIFY_INFO=false                 # true = also notify severity=info alerts (e.g. ApiNoTraffic)
# Optional extra channels (any subset; all free):
# ALERT_NTFY_URL=https://ntfy.sh/<long-random-topic>
# ALERT_DISCORD_WEBHOOK_URL=
# ALERT_SLACK_WEBHOOK_URL=
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=                      # generic Alertmanager JSON webhook
# Dead-man's switch + backup heartbeat (Healthchecks.io free: 20 checks):
# HEALTHCHECKS_WATCHDOG_URL=https://hc-ping.com/<uuid-of-the-watchdog-check>   # pinged by Alertmanager
# HEALTHCHECKS_URL=https://hc-ping.com/<uuid-of-the-backup-check>              # pinged by deploy/backup.sh
# Prometheus storage bounds:
# PROMETHEUS_RETENTION=15d
# PROMETHEUS_RETENTION_SIZE=2GB

# Extra https origins the dashboard may load images from (CSP img-src), comma-separated,
# e.g. avatar hosts: https://avatars.githubusercontent.com,https://www.gravatar.com
# S3_ENDPOINT / S3_PUBLIC_BASE_URL origins are added automatically.
# PINPOINT_IMG_ORIGINS=
