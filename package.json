{
  "name": "pinpoint",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "dashboard",
    "extension",
    "e2e",
    "mobile-sdk",
    "mcp-server",
    "widget"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "npm test --workspace e2e",
    "test:load": "k6 run loadtest/scenarios/mixed.js",
    "loadtest:seed": "node loadtest/seed.mts",
    "loadtest:clean": "node loadtest/seed.mts --clean",
    "typecheck": "tsc --build tsconfig.json",
    "lint": "npm run lint --workspaces --if-present && npm run lint:clients",
    "lint:clients": "eslint --max-warnings 0 --ext .ts dashboard/src extension/src extension/options extension/popup widget/src mcp-server/src shared/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "npx knex migrate:latest --knexfile server/knexfile.ts",
    "migrate:rollback": "npx knex migrate:rollback --knexfile server/knexfile.ts",
    "dev": "docker compose up",
    "dev:dashboard": "npm run dev --workspace dashboard",
    "dev:api": "npm run build --workspace shared && npm run build --workspace server && npm start --workspace server",
    "build:widget": "npm run build --workspace widget",
    "build:firefox": "npm run build:firefox --workspace extension",
    "package:firefox": "npm run package:firefox --workspace extension",
    "build:safari": "npm run build:safari --workspace extension",
    "build:safari-app": "npm run build:safari-app --workspace extension",
    "demo:seed": "node scripts/demo-seed.mts",
    "demo:reset": "node scripts/demo-seed.mts --reset",
    "demo:clean-test-data": "node scripts/demo-clean-test-data.mts",
    "docs:crash-course": "node scripts/build-crash-course.mts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.2",
    "fast-check": "4.11.0",
    "jsdom": "29.1.1",
    "marked": "18.3.0",
    "typescript": "7.0.2",
    "vitest": "5.1.2",
    "zod": "4.6.7"
  }
}
