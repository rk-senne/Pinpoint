    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/parser": "8.74.0",
    "eslint": "8.57.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "ts-node": "10.9.2"
