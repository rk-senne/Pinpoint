    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "ioredis": "6.1.0",
    "jsonwebtoken": "9.0.3",
    "knex": "3.3.0",
    "multer": "2.5.0",
    "nodemailer": "10.6.1",
